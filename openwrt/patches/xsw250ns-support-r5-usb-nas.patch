diff --git a/target/linux/airoha/patches-6.18/952-watchdog-airoha-handle-long-userspace-timeouts.patch b/target/linux/airoha/patches-6.18/952-watchdog-airoha-handle-long-userspace-timeouts.patch
new file mode 100644
index 0000000000..d65506e0d5
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/952-watchdog-airoha-handle-long-userspace-timeouts.patch
@@ -0,0 +1,33 @@
+From: XSW250NS board support <noreply@localhost>
+Subject: [PATCH] watchdog: airoha: let the core handle long userspace timeouts
+
+procd requests 30 seconds, beyond the 32-bit timer's approximately
+28-second limit at 150 MHz. Advertise the hardware heartbeat interval
+instead of rejecting the userspace timeout. Clamp the programmed timer
+to whole seconds within that interval, and let the watchdog core provide
+intermediate pings. Do not multiply a long userspace timeout by the clock
+rate, which would wrap the timer load register.
+
+--- a/drivers/watchdog/airoha_wdt.c
++++ b/drivers/watchdog/airoha_wdt.c
+@@ -59,7 +59,9 @@
+ 	val = readl(airoha_wdt->base + TIMER_CTRL);
+ 	val |= (WDT_TIMER_ENABLE | WDT_ENABLE | WDT_TIMER_INTERRUPT);
+ 	writel(val, airoha_wdt->base + TIMER_CTRL);
+-	val = wdog_dev->timeout * airoha_wdt->wdt_freq;
++	/* The core pings on behalf of userspace for longer timeouts. */
++	val = min(wdog_dev->timeout,
++		  wdog_dev->max_hw_heartbeat_ms / 1000) * airoha_wdt->wdt_freq;
+ 	writel(val, airoha_wdt->base + WDT_TIMER_LOAD_VALUE);
+ 
+ 	return 0;
+@@ -157,7 +159,8 @@
+ 	wdog_dev->info = &airoha_wdt_info;
+ 	wdog_dev->ops = &airoha_wdt_ops;
+ 	/* Bus 300MHz, watchdog 150MHz, 28 seconds */
+-	wdog_dev->max_timeout = FIELD_MAX(WDT_TIMER_VAL) / airoha_wdt->wdt_freq;
++	wdog_dev->max_hw_heartbeat_ms =
++		(FIELD_MAX(WDT_TIMER_VAL) / airoha_wdt->wdt_freq) * 1000;
+ 	wdog_dev->parent = dev;
+ 
+ 	watchdog_set_drvdata(wdog_dev, airoha_wdt);
