+++ b/target/linux/airoha/dts/an7581-vnpt-xsw250ns-ubi.dts
@@ -0,0 +1,302 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
+#include "an7581.dtsi"
+
+/ {
+	model = "VNPT iGate XSW250-NS (UBI)";
+	compatible = "vnpt,xsw250ns-ubi", "airoha,an7581", "airoha,en7581";
+
+	aliases {
+		ethernet0 = &gdm1;
+		ethernet1 = &gdm4;
+		serial0 = &uart1;
+		led-boot = &led_power;
+		led-failsafe = &led_power;
+		led-running = &led_power;
+		led-upgrade = &led_power;
+	};
+
+	chosen {
+		rootdisk = <&ubi_fit>;
+		bootargs = "console=ttyS0,115200 earlycon";
+		stdout-path = "serial0:115200n8";
+		linux,usable-memory-range = <0 0x80200000 0 0x1fe00000>;
+	};
+
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0 0x80000000 0 0x20000000>;
+	};
+
+	keys {
+		compatible = "gpio-keys";
+		reset {
+			label = "reset";
+			linux,code = <KEY_RESTART>;
+			gpios = <&en7581_pinctrl 0 GPIO_ACTIVE_LOW>;
+		};
+	};
+
+	leds {
+		compatible = "gpio-leds";
+		led_power: power {
+			color = <LED_COLOR_ID_GREEN>;
+			function = LED_FUNCTION_POWER;
+			gpios = <&en7581_pinctrl 17 GPIO_ACTIVE_LOW>;
+		};
+		/* The user's stock boot log selects /userfs/7581ptled.conf. */
+		wlan-2g {
+			label = "xsw250ns:wlan-2g";
+			gpios = <&en7581_pinctrl 15 GPIO_ACTIVE_LOW>;
+			linux,default-trigger = "phy0radio";
+			default-state = "off";
+		};
+		wlan-5g {
+			label = "xsw250ns:wlan-5g";
+			gpios = <&en7581_pinctrl 41 GPIO_ACTIVE_HIGH>;
+			linux,default-trigger = "phy1radio";
+			default-state = "off";
+		};
+		tel1 {
+			label = "xsw250ns:tel1";
+			gpios = <&en7581_pinctrl 24 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+		tel2 {
+			label = "xsw250ns:tel2";
+			gpios = <&en7581_pinctrl 33 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+	};
+};
+
+&en7581_pinctrl {
+	gpio-ranges = <&en7581_pinctrl 0 13 50>;
+	/* LAN LED muxes match the working XSW050NS reference DT. */
+	gswp1_led0_pins: gswp1-led0-pins {
+		mux { function = "phy1_led0"; pins = "gpio43"; };
+	};
+	gswp2_led0_pins: gswp2-led0-pins {
+		mux { function = "phy2_led0"; pins = "gpio44"; };
+	};
+	gswp3_led0_pins: gswp3-led0-pins {
+		mux { function = "phy3_led0"; pins = "gpio45"; };
+	};
+	gswp4_led0_pins: gswp4-led0-pins {
+		mux { function = "phy4_led0"; pins = "gpio46"; };
+	};
+	mdio_pins: mdio-pins {
+		mux {
+			function = "mdio";
+			groups = "mdio";
+		};
+		conf {
+			pins = "gpio2";
+			output-high;
+		};
+	};
+
+	pcie0_rst_pins: pcie0-rst-pins {
+		conf {
+			pins = "pcie_reset0";
+			drive-open-drain = <1>;
+		};
+	};
+
+	pcie1_rst_pins: pcie1-rst-pins {
+		conf {
+			pins = "pcie_reset1";
+			drive-open-drain = <1>;
+		};
+	};
+};
+
+&snfi { status = "okay"; };
+
+&spi_nand {
+	/* Match the supplied U-Boot and vendor on-die ECC configuration. */
+	nand-ecc-mode = "none";
+	nand-ecc-step-size = <2048>;
+	nand-ecc-strength = <0>;
+
+	partitions {
+		compatible = "fixed-partitions";
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		partition@0 {
+			label = "bl2";
+			reg = <0 0x20000>;
+			read-only;
+		};
+
+		partition@20000 {
+			label = "ubi";
+			reg = <0x20000 0xdda0000>;
+			compatible = "linux,ubi";
+			volumes {
+				ubi_fit: ubi-volume-fit { volname = "fit"; };
+				ubi-volume-fip { volname = "fip"; };
+				ubi-volume-ubootenv { volname = "ubootenv"; };
+				ubi-volume-ubootenv2 { volname = "ubootenv2"; };
+			};
+		};
+
+		reservearea: partition@ddc0000 {
+			label = "reservearea";
+			reg = <0xddc0000 0x240000>;
+			read-only;
+			nvmem-layout {
+				compatible = "fixed-layout";
+				#address-cells = <1>;
+				#size-cells = <1>;
+				eeprom: eeprom@4c000 { reg = <0x4c000 0x1000>; };
+			};
+		};
+
+		partition@e000000 {
+			label = "reserved-bmt";
+			reg = <0xe000000 0x2000000>;
+			read-only;
+		};
+	};
+};
+
+&npu { status = "okay"; };
+&eth { status = "okay"; };
+&gdm1 { status = "okay"; };
+&eth_pcs { status = "okay"; };
+
+&mdio {
+	en8811: ethernet-phy@f {
+		compatible = "ethernet-phy-id03a2.a411";
+		reg = <15>;
+		/* Shared XSW-050NS/250NS board wiring; validate on hardware. */
+		reset-gpios = <&en7581_pinctrl 27 GPIO_ACTIVE_LOW>;
+		reset-assert-us = <100000>;
+		reset-deassert-us = <20000>;
+	};
+};
+
+&switch {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&mdio_pins>;
+};
+
+/* Physical jack numbering must be confirmed on hardware. */
+&gsw_port1 { status = "okay"; label = "lan1"; };
+&gsw_port2 { status = "okay"; label = "lan2"; };
+&gsw_port3 { status = "okay"; label = "lan3"; };
+&gsw_port4 { status = "okay"; label = "lan4"; };
+&gsw_phy1 {
+	status = "okay";
+	interrupts = <1>;
+	pinctrl-names = "gbe-led";
+	pinctrl-0 = <&gswp1_led0_pins>;
+};
+&gsw_phy2 {
+	status = "okay";
+	interrupts = <2>;
+	pinctrl-names = "gbe-led";
+	pinctrl-0 = <&gswp2_led0_pins>;
+};
+&gsw_phy3 {
+	status = "okay";
+	interrupts = <3>;
+	pinctrl-names = "gbe-led";
+	pinctrl-0 = <&gswp3_led0_pins>;
+};
+&gsw_phy4 {
+	status = "okay";
+	interrupts = <4>;
+	pinctrl-names = "gbe-led";
+	pinctrl-0 = <&gswp4_led0_pins>;
+};
+
+&gsw_phy1_led0 {
+	status = "okay";
+	color = <LED_COLOR_ID_GREEN>;
+	function = LED_FUNCTION_LAN;
+	function-enumerator = <1>;
+	active-low;
+};
+&gsw_phy2_led0 {
+	status = "okay";
+	color = <LED_COLOR_ID_GREEN>;
+	function = LED_FUNCTION_LAN;
+	function-enumerator = <2>;
+	active-low;
+};
+&gsw_phy3_led0 {
+	status = "okay";
+	color = <LED_COLOR_ID_GREEN>;
+	function = LED_FUNCTION_LAN;
+	function-enumerator = <3>;
+	active-low;
+};
+&gsw_phy4_led0 {
+	status = "okay";
+	color = <LED_COLOR_ID_GREEN>;
+	function = LED_FUNCTION_LAN;
+	function-enumerator = <4>;
+	active-low;
+};
+
+/* EN7581 has #thermal-sensor-cells = <0>, so no index follows. */
+&cpu_thermal {
+	thermal-sensors = <&thermal>;
+};
+
+&gdm4 {
+	status = "okay";
+	openwrt,netdev-name = "lan2p5";
+	phy-mode = "2500base-x";
+	phy-handle = <&en8811>;
+};
+
+/* 0000:01:00.0 is the MT7916 HIF; 0001:01:00.0 is the main radio. */
+&pcie0 {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&pcie0_rst_pins>;
+};
+
+&pcie1 {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&pcie1_rst_pins>;
+	pcie@0,0 {
+		reg = <0 0 0 0 0>;
+		#address-cells = <3>;
+		#size-cells = <2>;
+		ranges;
+
+		wifi@0,0 {
+			compatible = "mediatek,mt76";
+			reg = <0 0 0 0 0>;
+			nvmem-cells = <&eeprom>;
+			nvmem-cell-names = "eeprom";
+		};
+	};
+};
+
+/* Modified board: D+/D- only. Do not claim the shared USB3/PCIe SerDes.
+ * Both USB2 roots are enabled because the mod photos do not identify the root.
+ * VBUS is supplied by the external 5V hardware mod; no guessed GPIO control. */
+&usb0 {
+	status = "okay";
+	maximum-speed = "high-speed";
+	phys = <&usb0_phy PHY_TYPE_USB2>;
+	mediatek,u3p-dis-msk = <1>;
+};
+&usb1 {
+	status = "okay";
+	maximum-speed = "high-speed";
+	phys = <&usb1_phy PHY_TYPE_USB2>;
+	mediatek,u3p-dis-msk = <1>;
+};
