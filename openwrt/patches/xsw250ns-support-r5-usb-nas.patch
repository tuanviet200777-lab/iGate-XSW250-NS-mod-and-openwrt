+#!/bin/sh
+
+. /lib/functions.sh
+. /lib/functions/system.sh
+
+[ "$(board_name)" = "vnpt,xsw250ns-ubi" ] || exit 0
+
+uci -q delete uhttpd.main.listen_https || :
+
+# Keep SQM, VPN policy routing and traffic accounting in the software path.
+# These services remain unconfigured until the administrator enables them.
+uci -q batch <<'EOF'
+set system.@system[0].hostname='XSW250NS'
+set firewall.@defaults[0].flow_offloading='0'
+set firewall.@defaults[0].flow_offloading_hw='0'
+set firewall.@defaults[0].fullcone='0'
+add_list uhttpd.main.listen_https='0.0.0.0:443'
+add_list uhttpd.main.listen_https='[::]:443'
+set uhttpd.main.redirect_https='1'
+commit system
+commit firewall
+commit uhttpd
+EOF
diff --git a/target/linux/airoha/an7581/base-files/usr/share/ucode/xsw250ns/ledpolicy.uc b/target/linux/airoha/an7581/base-files/usr/share/ucode/xsw250ns/ledpolicy.uc
