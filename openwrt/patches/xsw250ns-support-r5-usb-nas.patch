@@ -0,0 +1,30 @@
+#!/bin/sh /etc/rc.common
+START=99
+USE_PROCD=1
+
+start_service() {
+	[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = 'vnpt,xsw250ns-ubi' ] || return 0
+	[ "$(uci -q get xsw250ns_status.main.enabled)" != '0' ] || return 0
+	procd_open_instance
+	procd_set_param command /usr/libexec/xsw250ns-status
+	procd_set_param respawn 3600 5 5
+	procd_set_param term_timeout 10
+	procd_set_param stdout 0
+	procd_set_param stderr 1
+	procd_set_param file /etc/config/xsw250ns_status
+	procd_close_instance
+}
+
+service_triggers() {
+	procd_add_reload_trigger xsw250ns_status
+}
+
+stop_service() {
+	local led
+	for led in tel1 tel2; do
+		[ -d "/sys/class/leds/xsw250ns:$led" ] || continue
+		echo none > "/sys/class/leds/xsw250ns:$led/trigger"
+		echo 0 > "/sys/class/leds/xsw250ns:$led/brightness"
+	done
+	rm -f /var/run/xsw250ns/status.json
+}
