+
+/* Physical jack numbering must be confirmed on hardware. */
+&gsw_port1 { status = "okay"; label = "lan1"; };
+&gsw_port2 { status = "okay"; label = "lan2"; };
+&gsw_port3 { status = "okay"; label = "lan3"; };
+&gsw_port4 { status = "okay"; label = "lan4"; };
+&gsw_phy1 {
+	status = "okay";
