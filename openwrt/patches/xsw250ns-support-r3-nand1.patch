index 0000000000..0167557f5f
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/950-net-airoha-fix-external-serdes-nbq.patch
@@ -0,0 +1,30 @@
+From: pbs05 <27010143+pbs05@users.noreply.github.com>
+Subject: [PATCH] net: airoha: select NBQ for PPE egress on external SerDes
+
+GDM3 and GDM4 can each connect multiple net_devices through an external
+SerDes arbiter. The QDMA transmit path selects the net_device's NBQ, while
+PPE flow entries currently select NBQ 0 for direct GDM3/GDM4 egress.
+
+Observed IPv4 flow entries directed to GDM3 NBQ 5 and GDM4 NBQ 1 both
+carry NBQ 0. Program the net_device NBQ in those flow entries so PPE
+selects the same SerDes as the QDMA transmit path.
+
+Fixes: 7758cb462ff7 ("net: airoha: Introduce WAN device flag")
+Signed-off-by: pbs05 <27010143+pbs05@users.noreply.github.com>
+---
+ drivers/net/ethernet/airoha/airoha_ppe.c | 4 ++++
+ 1 file changed, 4 insertions(+)
+
+--- a/drivers/net/ethernet/airoha/airoha_ppe.c
++++ b/drivers/net/ethernet/airoha/airoha_ppe.c
+@@ -503,6 +503,10 @@ static int airoha_ppe_foe_entry_prepare(s
+ 			 */
+ 			if (airoha_is_lan_gdm_dev(dev))
+ 				val |= AIROHA_FOE_IB2_FAST_PATH;
++			/* GDM3/GDM4 select their external SerDes through NBQ. */
++			if (pse_port == FE_PSE_PORT_GDM3 ||
++			    pse_port == FE_PSE_PORT_GDM4)
++				val |= FIELD_PREP(AIROHA_FOE_IB2_NBQ, dev->nbq);
+ 			if (dsa_port >= 0)
+ 				val |= FIELD_PREP(AIROHA_FOE_IB2_NBQ,
+ 						  dsa_port);
diff --git a/target/linux/airoha/patches-6.18/951-net-pcs-airoha-fix-link-mode-and-calibration.patch b/target/linux/airoha/patches-6.18/951-net-pcs-airoha-fix-link-mode-and-calibration.patch
