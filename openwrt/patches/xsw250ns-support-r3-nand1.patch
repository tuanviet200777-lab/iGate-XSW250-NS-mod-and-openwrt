+Subject: [PATCH] net: pcs: airoha: fix link register selection and CDR calibration
+
+Backport the independent fixes reviewed in voz188/ponwrt commit
+c3b518baec8ed0cc5a353327fa154f38bde1e6c0, patch 310-09. Keep the current
+ImmortalWrt PCS interfaces and AN7583 support.
+
+Avoid a zero divisor when the CDR search reaches an exact match, use
+unsigned absolute differences, and select the AN register bank and 10M
+link mode correctly. The RX 1G mode must use the RX register field.
+
+--- a/drivers/net/pcs/airoha/pcs-airoha-common.c
++++ b/drivers/net/pcs/airoha/pcs-airoha-common.c
+@@ -687,7 +687,7 @@
+ 		regmap_set_bits(maps->hsgmii_pcs, AIROHA_PCS_HSGMII_PCS_CTROL_1,
+ 				AIROHA_PCS_SGMII_SEND_AN_ERR_EN);
+ 
+-		regmap_set_bits(maps->hsgmii_pcs, AIROHA_PCS_HSGMII_AN_SGMII_REG_AN_FORCE_CL37,
++		regmap_set_bits(maps->hsgmii_an, AIROHA_PCS_HSGMII_AN_SGMII_REG_AN_FORCE_CL37,
+ 				AIROHA_PCS_HSGMII_AN_FORCE_AN_DONE);
