+		};
+		/* The user's stock boot log selects /userfs/7581ptled.conf. */
+		wlan-2g {
+			label = "xsw250ns:wlan-2g";
+			gpios = <&en7581_pinctrl 15 GPIO_ACTIVE_LOW>;
+			linux,default-trigger = "phy0radio";
+			default-state = "off";
+		};
+		wlan-5g {
+			label = "xsw250ns:wlan-5g";
