+++ b/target/linux/airoha/an7581/base-files/etc/uci-defaults/95-xsw250ns-apk-feeds
@@ -0,0 +1,21 @@
+#!/bin/sh
+# The official aarch64_cortex-a53 video index returns HTTP 404 (2026-10-29).
+# Disable only that exact optional feed, preserving every other repository.
+[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = 'vnpt,xsw250ns-ubi' ] || exit 0
+for apk_feed in /etc/apk/repositories /etc/apk/repositories.d/*.list; do
+ [ -f "$apk_feed" ] || continue
+ awk '
+ { line=$0; sub(/^[ \t]+/, "", line); sub(/[ \t\r]+$/, "", line)
+   if (line == "https://downloads.immortalwrt.org/snapshots/packages/aarch64_cortex-a53/video/packages.adb")
+     print "# XSW250NS: optional video index unavailable (HTTP 404): " $0
+   else print $0
+ }' "$apk_feed" > "$apk_feed.xsw-new" || { rm -f "$apk_feed.xsw-new"; exit 1; }
+ if cmp -s "$apk_feed" "$apk_feed.xsw-new"; then rm -f "$apk_feed.xsw-new"; else
+  mkdir -p /etc/xsw250ns-apk-backup
+  chmod 700 /etc/xsw250ns-apk-backup
+  cp -p "$apk_feed" "/etc/xsw250ns-apk-backup/$(basename "$apk_feed").$(date +%s).before" || exit 1
+  cat "$apk_feed.xsw-new" > "$apk_feed" || exit 1
+  rm -f "$apk_feed.xsw-new"
+ fi
+done
+exit 0
