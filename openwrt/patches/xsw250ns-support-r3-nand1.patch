+#!/bin/sh
+
+[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = 'vnpt,xsw250ns-ubi' ] || exit 0
+
+# sysfixtime relies on inode mtimes, which are discarded by this recovery
+# kernel. Apply the build/last-shutdown lower bound on the first boot too.
+/etc/init.d/xsw250ns-clock enable
+/etc/init.d/xsw250ns-clock start
+
+uci set system.@system[0].timezone='ICT-7'
+uci set system.@system[0].zonename='Asia/Ho_Chi_Minh'
+uci set system.ntp='timeserver'
+uci set system.ntp.enabled='1'
+uci set system.ntp.use_dhcp='1'
+
+# Keep user-selected servers; populate defaults only when the list is empty.
+if [ -z "$(uci -q get system.ntp.server)" ]; then
+	uci add_list system.ntp.server='time.cloudflare.com'
+	uci add_list system.ntp.server='time.google.com'
+	uci add_list system.ntp.server='0.asia.pool.ntp.org'
+fi
+uci commit system
+/etc/init.d/sysntpd enable
