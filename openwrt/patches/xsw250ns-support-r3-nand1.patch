diff --git a/target/linux/airoha/an7581/base-files/etc/init.d/xsw250ns-clock b/target/linux/airoha/an7581/base-files/etc/init.d/xsw250ns-clock
new file mode 100755
index 0000000000..e6cde74f0e
--- /dev/null
+++ b/target/linux/airoha/an7581/base-files/etc/init.d/xsw250ns-clock
@@ -0,0 +1,45 @@
+#!/bin/sh /etc/rc.common
+
+START=01
+STOP=89
+
+valid_epoch() {
+	case "$1" in ''|*[!0-9]*) return 1 ;; esac
+	[ "${#1}" -le 10 ] && [ "$1" -ge 946684800 ] && [ "$1" -le 4102444800 ]
+}
+
+clock_floor() {
+	local build saved
+	build="$(sed -n 's/^OPENWRT_BUILD_DATE="\([0-9]*\)"$/\1/p' /usr/lib/os-release)"
+	valid_epoch "$build" || return 1
+	saved="$(cat /etc/xsw250ns-clock/epoch 2>/dev/null)"
+	if valid_epoch "$saved" && [ "$saved" -gt "$build" ]; then
+		build="$saved"
+	fi
+	printf '%s\n' "$build"
+}
+
+start() {
+	[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = 'vnpt,xsw250ns-ubi' ] || return 0
+	local floor now
+	floor="$(clock_floor)" || return 1
+	now="$(date +%s)"
+	if [ "$now" -lt "$floor" ]; then
+		date -u -s "@$floor" >/dev/null || return 1
+		logger -t xsw250ns-clock 'Restored approximate clock from firmware/last shutdown; waiting for NTP' 2>/dev/null || :
+	fi
+}
+
+stop() {
+	[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = 'vnpt,xsw250ns-ubi' ] || return 0
+	local floor now
+	floor="$(clock_floor)" || return 1
+	now="$(date +%s)"
+	valid_epoch "$now" && [ "$now" -ge "$floor" ] || return 0
+	# Save once on orderly shutdown, not every NTP poll, to limit flash writes.
+	( umask 077
+	  mkdir -p /etc/xsw250ns-clock || exit 1
+	  printf '%s\n' "$now" > /etc/xsw250ns-clock/epoch.new || exit 1
+	  mv /etc/xsw250ns-clock/epoch.new /etc/xsw250ns-clock/epoch
+	)
+}
