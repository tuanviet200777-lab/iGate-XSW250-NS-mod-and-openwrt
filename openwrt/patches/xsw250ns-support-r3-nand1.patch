+
+/* 0000:01:00.0 is the MT7916 HIF; 0001:01:00.0 is the main radio. */
+&pcie0 {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&pcie0_rst_pins>;
