--- /dev/null
+++ b/target/linux/airoha/an7581/base-files/usr/share/ucode/xsw250ns/ledpolicy.uc
@@ -0,0 +1,14 @@
+'use strict';
+
+export function thermal(previous, value, on, off) {
+	if (type(value) != 'int' && type(value) != 'double' || value < 0 || value > 150000) return previous;
+	if (value >= on * 1000) return true;
+	if (value < off * 1000) return false;
+	return previous;
+}
+
+export function reachability(previous, success, passes, failures) {
+	passes = success ? passes + 1 : 0;
+	failures = success ? 0 : failures + 1;
+	return { online: success && passes >= 2 ? true : !success && failures >= 3 ? false : previous, passes, failures };
+}
diff --git a/target/linux/airoha/an7581/base-files/usr/share/ucode/xsw250ns/policy.uc b/target/linux/airoha/an7581/base-files/usr/share/ucode/xsw250ns/policy.uc
new file mode 100644
index 0000000000..690464d8db
--- /dev/null
+++ b/target/linux/airoha/an7581/base-files/usr/share/ucode/xsw250ns/policy.uc
@@ -0,0 +1,78 @@
+'use strict';
+
+// Only data changes to existing UCI sections are accepted. No shell, files,
+// package installation, firmware writes, credentials or firewall rules.
+export const rules = {
+	network: { interface: { mtu: 'mtu', metric: 'uint', peerdns: 'bool', delegate: 'bool', disabled: 'bool', force_link: 'bool', ip6assign: 'prefix' } },
+	wireless: {
+		'wifi-device': { country: 'country', channel: 'channel', htmode: 'htmode', txpower: 'power', disabled: 'bool' },
+		'wifi-iface': { disabled: 'bool', disassoc_low_ack: 'bool', isolate: 'bool', ieee80211w: 'mfp', wmm: 'bool' }
+	},
+	firewall: { defaults: { flow_offloading: 'bool', flow_offloading_hw: 'bool', fullcone: 'bool', synflood_protect: 'bool' } },
+	dhcp: {
+		dnsmasq: { cachesize: 'uint', rebind_protection: 'bool', localservice: 'bool', domainneeded: 'bool', boguspriv: 'bool' },
+		dhcp: { ignore: 'bool', start: 'uint', limit: 'uint', leasetime: 'lease', ra: 'dhcp6', dhcpv6: 'dhcp6' }
+	},
+	sqm: { queue: { enabled: 'bool', download: 'rate', upload: 'rate' } },
+	pbr: { pbr: { enabled: 'bool', strict_enforcement: 'bool' } }
+};
+
+export function redact(text, secrets) {
+	let out = '' + (text ?? '');
+	for (let secret in sort(secrets ?? [], (a, b) => length(b) - length(a)))
+		if (type(secret) == 'string' && length(secret) >= 4)
+			out = join('[HIDDEN]', split(out, secret));
+	out = replace(out, /sk-[A-Za-z0-9_-]{8,}/g, '[API_KEY]');
+	out = replace(out, /([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}/g, '[MAC]');
+	out = replace(out, /[0-9]{1,3}(\.[0-9]{1,3}){3}/g, '[IP]');
+	out = replace(out, /[0-9a-fA-F]{0,4}(:[0-9a-fA-F]{0,4}){2,}/g, '[IPv6]');
+	out = replace(out, /((password|passwd|secret|token|psk|ssid|username|serial|Bearer)[ \t=:]+)[^\r\n]*/gi, '$1[HIDDEN]');
+	return out;
+}
+
+function validValue(value, kind) {
+	if (value == null) return true;
+	if (type(value) != 'string' || length(value) > 32 || match(value, /[\r\n]/)) return false;
+	if (kind == 'bool') return value == '0' || value == '1';
+	if (kind == 'country') return !!match(value, /^[A-Z]{2}$/);
+	if (kind == 'channel' && value == 'auto') return true;
+	if (kind == 'htmode') return !!match(value, /^(NOHT|HT20|HT40|VHT20|VHT40|VHT80|VHT160|HE20|HE40|HE80|HE160)$/);
+	if (kind == 'lease') return !!match(value, /^[1-9][0-9]{0,5}[smhdw]$/);
+	if (kind == 'dhcp6') return !!match(value, /^(disabled|server|relay|hybrid)$/);
+	if (!match(value, /^[0-9]+$/)) return false;
+	const n = +value;
+	if (kind == 'mtu') return n >= 576 && n <= 9000;
+	if (kind == 'prefix') return n == 0 || n >= 48 && n <= 64;
+	if (kind == 'power') return n >= 0 && n <= 36;
+	if (kind == 'channel') return n >= 1 && n <= 233;
+	if (kind == 'mfp') return n >= 0 && n <= 2;
+	if (kind == 'rate') return n >= 0 && n <= 10000000;
+	return n >= 0 && n <= 65535;
+}
+
+export function validate(doc, board, firmware, configs) {
+	if (type(doc) != 'object' || doc.schema != 1 || board != 'vnpt,xsw250ns-ubi' || doc.board != board)
+		die('Hotfix không đúng định dạng hoặc model XSW250-NS.');
+	if (doc.firmware != firmware || !length(firmware)) die('Hotfix dành cho phiên bản firmware khác.');
+	if (type(doc.id) != 'string' || !match(doc.id, /^[a-zA-Z0-9_-]{1,64}$/)) die('Mã Hotfix không hợp lệ.');
+	if (type(doc.title) != 'string' || !length(doc.title) || length(doc.title) > 160) die('Thiếu tên Hotfix.');
+	if (type(doc.changes) != 'array' || !length(doc.changes) || length(doc.changes) > 24) die('Hotfix phải có từ 1 đến 24 thay đổi.');
+	const seen = {}, changes = [], affected = {};
+	for (let c in doc.changes) {
+		if (type(c) != 'object' || type(c.section) != 'string' || !match(c.section, /^[A-Za-z0-9_]+$/)) die('Section UCI không hợp lệ.');
+		const section = configs[c.config]?.[c.section];
+		const kind = rules[c.config]?.[section?.['.type']]?.[c.option];
+		if (!kind) die('Tùy chọn nằm ngoài phạm vi Hotfix cho phép.');
+		if (!('expect' in c) || !('value' in c)) die('Cần giá trị hiện tại expect và giá trị mới value.');
+		if (!validValue(c.value, kind)) die('Giá trị mới không hợp lệ.');
+		if (sprintf('%J', section[c.option] ?? null) != sprintf('%J', c.expect)) die('Cấu hình đã thay đổi; cần tạo lại Hotfix.');
+		const key = `${c.config}.${c.section}.${c.option}`;
+		if (seen[key]) die('Hotfix có tùy chọn trùng lặp.');
+		seen[key] = true;
+		if (sprintf('%J', c.value) == sprintf('%J', c.expect)) continue;
+		push(changes, { config: c.config, section: c.section, option: c.option, expect: c.expect, value: c.value });
+		affected[c.config] = true;
+	}
+	if (!length(changes)) die('Hotfix không làm thay đổi cấu hình.');
+	return { id: doc.id, title: doc.title, changes, configs: keys(affected) };
+}
diff --git a/target/linux/airoha/an7581/base-files/www/luci-static/resources/view/status/include/99_xsw250ns_port.js b/target/linux/airoha/an7581/base-files/www/luci-static/resources/view/status/include/99_xsw250ns_port.js
new file mode 100644
index 0000000000..690120f57d
--- /dev/null
+++ b/target/linux/airoha/an7581/base-files/www/luci-static/resources/view/status/include/99_xsw250ns_port.js
@@ -0,0 +1,97 @@
+'use strict';
+'require baseclass';
+'require rpc';
+'require uci';
+'require ui';
+'require xsw250ns.portrole as portrole';
+
+const board = rpc.declare({ object: 'system', method: 'board', expect: { '': {} } });
+const config = rpc.declare({ object: 'uci', method: 'get', params: ['config'], expect: { values: {} }, reject: true });
+const access = rpc.declare({ object: 'session', method: 'access', params: ['scope', 'object', 'function'], expect: { access: false } });
+
+function hasChanges(changes) {
+	return Object.keys(changes).some(name => changes[name]?.length);
+}
+
+return baseclass.extend({
+	title: 'Cổng 2.5G LAN/WAN',
+
+	async load() {
+		const info = await board();
+		if (info.board_name != 'vnpt,xsw250ns-ubi')
+			return null;
+		if (this.busy)
+			return this.snapshot;
+		const data = await Promise.all([config('network'), config('firewall'), L.resolveDefault(access('uci', 'network', 'write'), false), L.resolveDefault(access('uci', 'firewall', 'write'), false)]);
+		this.snapshot = data;
+		return data;
+	},
+
+	async handleApply(role) {
+		if (this.busy)
+			return;
+		this.busy = true;
+		try {
+			if (hasChanges(await uci.changes()))
+				throw new Error('Đang có thay đổi chưa áp dụng. Hãy áp dụng hoặc hoàn tác các thay đổi đó trước.');
+			if (!await access('uci', 'network', 'write') || !await access('uci', 'firewall', 'write'))
+				throw new Error('Tài khoản không có quyền sửa cấu hình mạng.');
+			// Use a separate cursor so polling and other status cards keep their state.
+			const cursor = new uci.constructor();
+			await cursor.load(['network', 'firewall']);
+			const values = name => {
+				const result = {};
+				cursor.sections(name, null, s => { result[s['.name']] = s; });
+				return result;
+			};
+			const ops = portrole.plan(values('network'), values('firewall'), role);
+			if (!ops.length)
+				return;
+			for (const op of ops) {
+				if (op.type) cursor.add(op.config, op.type, op.section);
+				else if (op.remove) cursor.remove(op.config, op.section);
+				else if (op.value == null) cursor.unset(op.config, op.section, op.option);
+				else cursor.set(op.config, op.section, op.option, op.value);
+			}
+			if (hasChanges(await uci.changes()))
+				throw new Error('Có thay đổi cấu hình mới từ phiên này. Hãy xử lý thay đổi đang chờ trước.');
+			await cursor.save();
+			await ui.changes.init();
+			this.selectedRole = null;
+			ui.changes.apply(true);
+		} catch (error) {
+			ui.addNotification(null, E('p', {}, error.message || String(error)), 'error');
+		} finally {
+			this.busy = false;
+		}
+	},
+
+	render(data) {
+		if (!data)
+			return null;
+		const status = portrole.inspect(data[0], data[1]);
+		const labels = { lan: 'LAN — cùng mạng với 4 cổng LAN 1G', wan: 'WAN — kết nối Internet', unused: 'Chưa gán vai trò', custom: 'Cấu hình tùy chỉnh' };
+		const writable = data[2] && data[3];
+		const selected = this.selectedRole || (status.role == 'lan' ? 'lan' : 'wan');
+		const select = E('select', { 'class': 'cbi-input-select', 'disabled': this.busy || !writable || !status.supported ? true : null }, [
+			E('option', { value: 'lan', selected: selected == 'lan' ? true : null }, 'LAN'),
+			E('option', { value: 'wan', selected: selected == 'wan' ? true : null }, 'WAN')
+		]);
+		const button = E('button', {
+			'class': 'cbi-button cbi-button-apply',
+			'disabled': this.busy || !writable || !status.supported || selected == status.role ? true : null,
+			'click': ui.createHandlerFn(this, () => this.handleApply(select.value))
+		}, 'Lưu & áp dụng');
+		select.addEventListener('change', () => {
+			this.selectedRole = select.value;
+			button.disabled = this.busy || !writable || !status.supported || select.value == status.role;
+		});
+		return E('div', {}, [
+			E('p', {}, ['Vai trò hiện tại: ', E('strong', {}, labels[status.role])]),
+			E('div', { 'class': 'cbi-value' }, [select, ' ', button]),
+			E('p', { 'class': 'cbi-value-description' }, status.reason || 'Cắm máy tính quản trị vào một cổng LAN 1G trước khi chuyển. Chuyển sang LAN sẽ ngắt đường Internet qua cổng 2.5G; chuyển lại WAN sẽ giữ cấu hình WAN đã có, hoặc dùng DHCP nếu chưa có.'),
+			!writable ? E('p', {}, 'Tài khoản hiện tại chỉ có quyền xem.') : null,
+			E('a', { href: L.url('admin/network/network') }, 'Cấu hình mạng nâng cao')
+		]);
+	}
+});
